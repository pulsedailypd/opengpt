# Your Firebase project ID (Firebase console > Project settings > General)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Your AI provider key. Keep it here on the server, never in the browser code.
AI_API_KEY=sk-...

# Any OpenAI-compatible chat completions API works (OpenAI, OpenRouter, Groq, Together, local servers...)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

PORT=3000
