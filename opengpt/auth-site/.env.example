# Your Firebase project ID (Firebase console > Project settings > General)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Your AI provider key. Keep it here on the server, never in the browser code.
AI_API_KEY=your-key

# Any OpenAI-compatible chat completions API works.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Optional: a model that can read images. Needed only for the image upload feature.
# Check your provider's model list for one that accepts image input.
AI_VISION_MODEL=

PORT=3000
